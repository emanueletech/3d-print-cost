{
  "name": "costo-stampa-3d",
  "version": "1.1.5",
  "description": "Calcolo tempi, materiali e costi di stampa 3D",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "pack": "electron-builder --dir"
  },
  "keywords": [],
  "author": {
    "name": "Emanuele",
    "email": "281643038+emanueletech@users.noreply.github.com"
  },
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "tech.emanuele.printcost",
    "productName": "3D Print Cost",
    "copyright": "Copyright © Emanuele",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "build/icon.ico",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "protocols": [
      {
        "name": "3D Print Cost",
        "schemes": [
          "printcost"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "3D Print Cost",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "multiLanguageInstaller": true,
      "displayLanguageSelector": true,
      "installerLanguages": [
        "it_IT",
        "en_US",
        "es_ES",
        "fr_FR"
      ],
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "3D-Print-Cost-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "3D-Print-Cost-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "artifactName": "3D-Print-Cost-${version}-mac.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "icon": "build/icon.png",
      "artifactName": "3D-Print-Cost-${version}.${ext}",
      "synopsis": "Tempi, materiali e costo reale delle stampe 3D",
      "maintainer": "Emanuele <281643038+emanueletech@users.noreply.github.com>",
      "syncDesktopName": true
    },
    "deb": {
      "artifactName": "3D-Print-Cost-${version}.${ext}"
    }
  },
  "homepage": "https://github.com/emanueletech/3d-print-cost",
  "desktopName": "3DPrintCost"
}
